---
import { ICONS } from '../ui/icons.ts';

interface Props {
  name: keyof typeof ICONS;
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
