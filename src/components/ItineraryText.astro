---
import type { Itinerary } from '../domain/itinerary.ts';
import { changes, clock, duration, step } from '../ui/format.ts';

interface Props {
  itinerary: Itinerary;
  origin: string;
  destination: string;
}

const { itinerary, origin, destination } = Astro.props;
---

<p>
  Départ à <time datetime={itinerary.departure.toISOString()}>{clock(itinerary.departure)}</time>,{' '}
  arrivée à <time datetime={itinerary.arrival.toISOString()}>{clock(itinerary.arrival)}</time> :{' '}
  {duration(itinerary.departure, itinerary.arrival)}, {changes(itinerary)}.
</p>
<ol>
  {itinerary.legs.map((leg) => <li>{step(leg, origin, destination)}</li>)}
</ol>
