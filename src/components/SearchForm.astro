---
import type { SearchField, SearchForm } from '../domain/search.ts';
import PlaceInput from './PlaceInput.vue';

interface Props {
  values?: SearchForm;
  missing?: SearchField[];
}

const { values = { from: '', to: '', folding: false }, missing = [] } = Astro.props;
const at = (coordinates: SearchForm['fromAt']) => coordinates && `${coordinates.lat},${coordinates.lon}`;
---

<form method="get" action="/trajet">
  <PlaceInput
    client:load
    name="de"
    coordinatesName="dep"
    label="Départ"
    value={values.from}
    coordinates={at(values.fromAt)}
    error={missing.includes('from') ? 'Indiquez un lieu de départ.' : undefined}
    locate
  />
  <PlaceInput
    client:load
    name="a"
    coordinatesName="arr"
    label="Arrivée"
    value={values.to}
    coordinates={at(values.toAt)}
    error={missing.includes('to') ? 'Indiquez un lieu d’arrivée.' : undefined}
  />
  <div class="option">
    <label>
      <input name="velo" type="checkbox" value="pliant" checked={values.folding} aria-describedby="velo-aide" />
      J’ai un vélo pliant
    </label>
    <p id="velo-aide">Plié, votre vélo monte aussi dans le bus.</p>
  </div>
  <button type="submit" class="primary">Comparer les trajets</button>
</form>

<style>
  form {
    padding: 0.25rem 1rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .option {
    margin: 1.25rem 0;
  }

  /* The whole line toggles the box: a 44 px target, the box itself staying the size people expect. */
  label {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  input[type='checkbox'] {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    accent-color: var(--accent);
  }

  #velo-aide {
    margin: 0 0 0 2.25rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
