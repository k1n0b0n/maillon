---
import type { SearchField, SearchForm } from '../domain/search.ts';
import PlaceInput from './PlaceInput.vue';

interface Props {
  values?: SearchForm;
  missing?: SearchField[];
}

const { values = { from: '', to: '', folding: false }, missing = [] } = Astro.props;
const at = (coordinates: SearchForm['fromAt']) => coordinates && `${coordinates.lat},${coordinates.lon}`;
---

<form method="get" action="/trajet">
  <PlaceInput
    client:load
    name="de"
    coordinatesName="dep"
    label="Départ"
    value={values.from}
    coordinates={at(values.fromAt)}
    error={missing.includes('from') ? 'Indiquez un lieu de départ.' : undefined}
    locate
  />
  <PlaceInput
    client:load
    name="a"
    coordinatesName="arr"
    label="Arrivée"
    value={values.to}
    coordinates={at(values.toAt)}
    error={missing.includes('to') ? 'Indiquez un lieu d’arrivée.' : undefined}
  />
  <p class="option">
    <input id="velo" name="velo" type="checkbox" value="pliant" checked={values.folding} />
    <label for="velo">J’ai un vélo pliant</label>
  </p>
  <button type="submit">Comparer les trajets</button>
</form>

<style>
  button {
    padding: 0.5rem 1rem;
    font: inherit;
  }
</style>
