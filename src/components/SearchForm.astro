---
import type { Bike } from '../domain/itinerary.ts';
import { BIKE_PARAMS, type SearchField, type SearchForm } from '../domain/search.ts';
import PlaceInput from './PlaceInput.vue';

interface Props {
  values?: SearchForm;
  missing?: SearchField[];
}

const { values = { from: '', to: '', bike: 'classic' }, missing = [] } = Astro.props;
const BIKES: [Bike, string][] = [
  ['none', 'Pas de vélo'],
  ['classic', 'Vélo classique'],
  ['folding', 'Vélo pliant'],
];
const at = (coordinates: SearchForm['fromAt']) => coordinates && `${coordinates.lat},${coordinates.lon}`;
---

<form method="get" action="/trajet">
  <PlaceInput
    client:load
    name="de"
    coordinatesName="dep"
    label="Départ"
    value={values.from}
    coordinates={at(values.fromAt)}
    error={missing.includes('from') ? 'Indiquez un lieu de départ.' : undefined}
    locate
  />
  <PlaceInput
    client:load
    name="a"
    coordinatesName="arr"
    label="Arrivée"
    value={values.to}
    coordinates={at(values.toAt)}
    error={missing.includes('to') ? 'Indiquez un lieu d’arrivée.' : undefined}
  />
  <fieldset>
    <legend>Votre vélo</legend>
    {
      BIKES.map(([bike, label]) => (
        <label>
          <input
            name="velo"
            type="radio"
            value={BIKE_PARAMS[bike]}
            checked={values.bike === bike}
            aria-describedby={bike === 'folding' ? 'velo-aide' : undefined}
          />
          {label}
        </label>
      ))
    }
    <p id="velo-aide">Plié, il monte aussi dans le bus.</p>
  </fieldset>
  <button type="submit" class="primary">Comparer les trajets</button>
</form>

<style>
  form {
    padding: 0.25rem 1rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  fieldset {
    margin: 1.25rem 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    font-weight: 600;
  }

  /* The whole line checks the radio: a 44 px target, the radio itself staying the size people expect. */
  label {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
  }

  input[type='radio'] {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    accent-color: var(--accent);
  }

  #velo-aide {
    margin: 0 0 0 2.25rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
