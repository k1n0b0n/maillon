---
import { MOTIS_URL } from 'astro:env/server';
import { cachedCompare } from '../adapters/motis/cache.ts';
import { findPlace } from '../adapters/motis/geocode.ts';
import Icon from '../components/Icon.astro';
import ItineraryMap from '../components/ItineraryMap.vue';
import OptionCard from '../components/OptionCard.astro';
import SearchForm from '../components/SearchForm.astro';
import ShowOnMap from '../components/ShowOnMap.vue';
import { isInsideArea } from '../domain/area.ts';
import { type Card, cards, optionsFor } from '../domain/comparison.ts';
import type { Place } from '../domain/itinerary.ts';
import { BIKE_PARAMS, parseSearch, type SearchForm as Search } from '../domain/search.ts';
import Base from '../layouts/Base.astro';
import { optionName } from '../ui/options.ts';

type Outcome =
  | { kind: 'missing' }
  | { kind: 'unknown'; texts: string[] }
  | { kind: 'outside'; names: string[] }
  | { kind: 'down' }
  | { kind: 'found'; from: Place; to: Place; cards: Card[]; time: Date };

const parsed = parseSearch(Astro.url.searchParams);
const values = parsed.complete ? parsed.search : parsed.values;

/** A chosen suggestion or position comes with its coordinates; a typed name goes to the geocoder (E4.1). */
async function place(name: string, coordinates: Search['fromAt']): Promise<Place | undefined> {
  return coordinates ? { name, coordinates } : findPlace(MOTIS_URL, name);
}

async function search(texts: Search): Promise<Outcome> {
  const [from, to] = await Promise.all([place(texts.from, texts.fromAt), place(texts.to, texts.toAt)]);
  if (from === undefined || to === undefined) {
    return { kind: 'unknown', texts: [from ? undefined : texts.from, to ? undefined : texts.to].filter((text) => text !== undefined) };
  }
  const outside = [from, to].filter(({ coordinates }) => !isInsideArea(coordinates)).map(({ name }) => name);
  if (outside.length > 0) {
    return { kind: 'outside', names: outside };
  }
  // To the minute: the map asks for the same search, and the cache knows it.
  const time = texts.at ?? new Date(Math.floor(Date.now() / 60_000) * 60_000);
  const comparison = await cachedCompare(MOTIS_URL, {
    from: from.coordinates,
    to: to.coordinates,
    time,
    arriveBy: false,
    bike: texts.bike,
  });
  return { kind: 'found', from, to, cards: cards(comparison, optionsFor(texts.bike)), time };
}

let outcome: Outcome;
if (!parsed.complete) {
  outcome = { kind: 'missing' };
} else {
  try {
    outcome = await search(parsed.search);
  } catch (error) {
    console.error('search failed:', error);
    outcome = { kind: 'down' };
    Astro.response.status = 503;
  }
}

const at = ({ lat, lon }: Place['coordinates']) => `${lat.toFixed(5)},${lon.toFixed(5)}`;
const mapQuery =
  outcome.kind === 'found'
    ? new URLSearchParams({
        de: outcome.from.name,
        dep: at(outcome.from.coordinates),
        a: outcome.to.name,
        arr: at(outcome.to.coordinates),
        quand: outcome.time.toISOString(),
        velo: BIKE_PARAMS[values.bike],
      }).toString()
    : '';
// The way back keeps the time asked, if any, and the bike.
const reverseQuery =
  outcome.kind === 'found'
    ? new URLSearchParams({
        de: outcome.to.name,
        dep: at(outcome.to.coordinates),
        a: outcome.from.name,
        arr: at(outcome.from.coordinates),
        ...(values.at ? { quand: values.at.toISOString() } : {}),
        velo: BIKE_PARAMS[values.bike],
      }).toString()
    : '';

// `cards()` sorts the options found first, by arrival: the best one is the first, if any.
const best = outcome.kind === 'found' && outcome.cards[0]?.itinerary ? outcome.cards[0] : undefined;
const others = outcome.kind === 'found' ? outcome.cards.filter((card) => card !== best) : [];
const mapOptions = outcome.kind === 'found' ? outcome.cards.filter(({ itinerary }) => itinerary).map(({ kind }) => ({ kind, name: optionName(kind, values.bike) })) : [];

const title =
  outcome.kind === 'found'
    ? `${outcome.from.name} → ${outcome.to.name}`
    : outcome.kind === 'missing'
      ? 'Erreur – Où allez-vous ?'
      : `Erreur – ${values.from} → ${values.to}`;
---

<Base title={title}>
  {
    outcome.kind === 'found' && (
      <>
        <h1>
          {outcome.from.name} → {outcome.to.name}
        </h1>
        <div class="search">
          <p>Départ maintenant. Les options sont classées par heure d’arrivée.</p>
          <a class="swap" href={`/trajet?${reverseQuery}`}>
            <Icon name="swap" />
            Inverser le trajet
          </a>
        </div>
        {best && (
          <section aria-labelledby="meilleure">
            <h2 id="meilleure">Meilleure option</h2>
            <OptionCard card={best} origin={outcome.from.name} destination={outcome.to.name} bike={values.bike} best>
              <ItineraryMap slot="map" client:load query={mapQuery} options={mapOptions} initial={best.kind} />
            </OptionCard>
          </section>
        )}
        {others.length > 0 && (
          <section aria-labelledby="autres">
            <h2 id="autres">{best ? 'Autres options' : 'Aucun trajet trouvé'}</h2>
            <ol class="cards">
              {others.map((card) => (
                <OptionCard card={card} origin={outcome.from.name} destination={outcome.to.name} bike={values.bike}>
                  {card.itinerary && <ShowOnMap slot="map" client:load kind={card.kind} name={optionName(card.kind, values.bike)} />}
                </OptionCard>
              ))}
            </ol>
          </section>
        )}
        <h2>Modifier la recherche</h2>
      </>
    )
  }
  {
    outcome.kind === 'unknown' && (
      <>
        <h1>Lieu introuvable</h1>
        <p role="alert">
          Nous ne trouvons pas {outcome.texts.map((text) => `« ${text} »`).join(' ni ')}. Essayez un nom d’arrêt ou une
          adresse.
        </p>
      </>
    )
  }
  {
    outcome.kind === 'down' && (
      <>
        <h1>Calcul indisponible</h1>
        <p role="alert">Le calcul d’itinéraire ne répond pas pour le moment. Réessayez dans une minute.</p>
      </>
    )
  }
  {
    outcome.kind === 'outside' && (
      <>
        <h1>Hors de la zone couverte</h1>
        <p role="alert">
          {outcome.names.map((name) => `« ${name} »`).join(' et ')} : maillon ne couvre que la Gironde et ses abords pour l’instant.
        </p>
      </>
    )
  }
  {outcome.kind === 'missing' && <h1>Où allez-vous ?</h1>}
  <SearchForm values={values} missing={parsed.complete ? [] : parsed.missing} />
</Base>

<style>
  .search p {
    margin: 0;
    color: var(--muted);
  }

  .swap {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  section h2 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.25rem;
  }

  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
