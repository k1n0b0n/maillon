---
import { MOTIS_URL } from 'astro:env/server';
import { cachedCompare } from '../adapters/motis/cache.ts';
import { findPlace } from '../adapters/motis/geocode.ts';
import Icon from '../components/Icon.astro';
import ItineraryMap from '../components/ItineraryMap.vue';
import OptionCard from '../components/OptionCard.astro';
import OptionPicker from '../components/OptionPicker.vue';
import SearchForm from '../components/SearchForm.astro';
import { isInsideArea } from '../domain/area.ts';
import { type Card, cards, optionsFor, shownCard } from '../domain/comparison.ts';
import type { Place } from '../domain/itinerary.ts';
import { BIKE_PARAMS, OPTION_PARAMS, parseOption, parseSearch, type SearchForm as Search } from '../domain/search.ts';
import Base from '../layouts/Base.astro';
import { clock, duration } from '../ui/format.ts';
import { cardModes, optionLabel, optionName, type PickerOption } from '../ui/options.ts';

type Outcome =
  | { kind: 'missing' }
  | { kind: 'unknown'; texts: string[] }
  | { kind: 'outside'; names: string[] }
  | { kind: 'down' }
  | { kind: 'found'; from: Place; to: Place; cards: Card[]; time: Date };

const parsed = parseSearch(Astro.url.searchParams);
const values = parsed.complete ? parsed.search : parsed.values;

/** A chosen suggestion or position comes with its coordinates; a typed name goes to the geocoder (E4.1). */
async function place(name: string, coordinates: Search['fromAt']): Promise<Place | undefined> {
  return coordinates ? { name, coordinates } : findPlace(MOTIS_URL, name);
}

async function search(texts: Search): Promise<Outcome> {
  const [from, to] = await Promise.all([place(texts.from, texts.fromAt), place(texts.to, texts.toAt)]);
  if (from === undefined || to === undefined) {
    return { kind: 'unknown', texts: [from ? undefined : texts.from, to ? undefined : texts.to].filter((text) => text !== undefined) };
  }
  const outside = [from, to].filter(({ coordinates }) => !isInsideArea(coordinates)).map(({ name }) => name);
  if (outside.length > 0) {
    return { kind: 'outside', names: outside };
  }
  // To the minute: the map asks for the same search, and the cache knows it.
  const time = texts.at ?? new Date(Math.floor(Date.now() / 60_000) * 60_000);
  const comparison = await cachedCompare(MOTIS_URL, {
    from: from.coordinates,
    to: to.coordinates,
    time,
    arriveBy: false,
    bike: texts.bike,
  });
  return { kind: 'found', from, to, cards: cards(comparison, optionsFor(texts.bike)), time };
}

let outcome: Outcome;
if (!parsed.complete) {
  outcome = { kind: 'missing' };
} else {
  try {
    outcome = await search(parsed.search);
  } catch (error) {
    console.error('search failed:', error);
    outcome = { kind: 'down' };
    Astro.response.status = 503;
  }
}

const at = ({ lat, lon }: Place['coordinates']) => `${lat.toFixed(5)},${lon.toFixed(5)}`;
const mapQuery =
  outcome.kind === 'found'
    ? new URLSearchParams({
        de: outcome.from.name,
        dep: at(outcome.from.coordinates),
        a: outcome.to.name,
        arr: at(outcome.to.coordinates),
        quand: outcome.time.toISOString(),
        velo: BIKE_PARAMS[values.bike],
      }).toString()
    : '';
// The way back keeps the time asked, if any, and the bike.
const reverseQuery =
  outcome.kind === 'found'
    ? new URLSearchParams({
        de: outcome.to.name,
        dep: at(outcome.to.coordinates),
        a: outcome.from.name,
        arr: at(outcome.from.coordinates),
        ...(values.at ? { quand: values.at.toISOString() } : {}),
        velo: BIKE_PARAMS[values.bike],
      }).toString()
    : '';

const found = outcome.kind === 'found' ? outcome.cards : [];
// `cards()` sorts the options found first, by arrival: the best one is the first, if any.
const best = found[0]?.itinerary ? found[0] : undefined;
const shown = shownCard(found, parseOption(Astro.url.searchParams));
const mapOptions = found.filter(({ itinerary }) => itinerary).map(({ kind }) => ({ kind, name: optionName(kind, values.bike) }));
// Each option's link keeps the search and says which option to show: it works without JavaScript, and shares.
const pickerOptions = found.map((card): PickerOption => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('option', OPTION_PARAMS[card.kind]);
  const { itinerary } = card;
  return {
    kind: card.kind,
    name: optionName(card.kind, values.bike),
    label: optionLabel(card.kind, values.bike),
    modes: cardModes(card),
    href: `/trajet?${params}`,
    first: card === best,
    ...(itinerary && {
      arrival: { text: clock(itinerary.arrival), iso: itinerary.arrival.toISOString() },
      duration: duration(itinerary.departure, itinerary.arrival),
    }),
  };
});

const title =
  outcome.kind === 'found'
    ? `${outcome.from.name} → ${outcome.to.name}`
    : outcome.kind === 'missing'
      ? 'Erreur – Où allez-vous ?'
      : `Erreur – ${values.from} → ${values.to}`;
---

<Base title={title}>
  {
    outcome.kind === 'found' && (
      <>
        <h1>
          {outcome.from.name} → {outcome.to.name}
        </h1>
        <p class="search">
          Départ maintenant.
          <a class="swap" href={`/trajet?${reverseQuery}`}>
            <Icon name="swap" />
            Inverser le trajet
          </a>
        </p>
        {shown ? (
          <>
            <OptionPicker client:load options={pickerOptions} initial={shown.kind} />
            <ItineraryMap client:load query={mapQuery} options={mapOptions} initial={shown.kind} />
          </>
        ) : (
          <h2>Aucun trajet trouvé</h2>
        )}
        {found.map((card) => (
          <OptionCard
            card={card}
            origin={outcome.from.name}
            destination={outcome.to.name}
            bike={values.bike}
            best={card === best}
            hidden={shown !== undefined && card !== shown}
          />
        ))}
        <h2>Modifier la recherche</h2>
      </>
    )
  }
  {
    outcome.kind === 'unknown' && (
      <>
        <h1>Lieu introuvable</h1>
        <p role="alert">
          Nous ne trouvons pas {outcome.texts.map((text) => `« ${text} »`).join(' ni ')}. Essayez un nom d’arrêt ou une
          adresse.
        </p>
      </>
    )
  }
  {
    outcome.kind === 'down' && (
      <>
        <h1>Calcul indisponible</h1>
        <p role="alert">Le calcul d’itinéraire ne répond pas pour le moment. Réessayez dans une minute.</p>
      </>
    )
  }
  {
    outcome.kind === 'outside' && (
      <>
        <h1>Hors de la zone couverte</h1>
        <p role="alert">
          {outcome.names.map((name) => `« ${name} »`).join(' et ')} : maillon ne couvre que la Nouvelle-Aquitaine pour l’instant.
        </p>
      </>
    )
  }
  {outcome.kind === 'missing' && <h1>Où allez-vous ?</h1>}
  <SearchForm values={values} missing={parsed.complete ? [] : parsed.missing} />
</Base>

<style>
  /* Short, so that the picker and the map fit a phone's first screen. */
  h1 {
    margin-bottom: 0;
    font-size: 1.375rem;
  }

  .search {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    align-items: center;
    margin: 0;
    color: var(--muted);
  }

  .swap {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }
</style>
