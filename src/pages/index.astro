---
import SearchForm from '../components/SearchForm.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Où allez-vous ?">
  <h1>Où allez-vous ?</h1>
  <p class="lead">
    À pied, à vélo, en transports ou avec votre vélo dans le tram, le TER ou le Bato : maillon compare vos trajets dans la
    métropole de Bordeaux.
  </p>
  <SearchForm />
</Base>

<style>
  .lead {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }
</style>
