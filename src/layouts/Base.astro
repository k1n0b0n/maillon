---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Comparer marche, vélo, transports en commun et vélo embarqué à Bordeaux." />
    <title>{title} – maillon</title>
  </head>
  <body>
    <header>
      <a href="/" class="brand">
        <svg viewBox="0 0 34 20" width="34" height="20" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true" focusable="false">
          <rect x="2" y="3.5" width="18" height="13" rx="6.5"></rect>
          <rect x="14" y="3.5" width="18" height="13" rx="6.5"></rect>
        </svg>
        maillon
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Données : TBM (Licence Ouverte), SNCF (ODbL), ©&nbsp;<a href="https://www.openstreetmap.org/copyright"
          >contributeurs OpenStreetMap</a
        > (ODbL). <a href="https://github.com/k1n0b0n/maillon">Code source</a> sous licence MIT.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --text: #1b1b1b;
    --muted: #575c61;
    --background: #f3f4f6;
    --surface: #fff;
    --border: #d3d7dc;
    /* Borders of fields and buttons: 3:1 at least against the page and the cards (RGAA 3.3). */
    --control: #6c737a;
    --accent: #005f87;
    --accent-soft: #e1eff6;
    --on-accent: #fff;
    --error: #b00020;
    --radius: 0.5rem;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --text: #ececec;
      --muted: #b5b9bd;
      --background: #121416;
      --surface: #1d2023;
      --border: #3a3f44;
      --control: #8b9299;
      --accent: #7cc8ef;
      --accent-soft: #15384a;
      --on-accent: #0b1a22;
      --error: #ff8a8a;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0 auto;
    max-width: 40rem;
    padding: 0 1rem;
    color: var(--text);
    background: var(--background);
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: 1.75rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  a {
    color: var(--accent);
  }

  time {
    font-variant-numeric: tabular-nums;
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  input[type='text'] {
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 0.75rem;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 2px solid var(--control);
    border-radius: var(--radius);
  }

  button {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 2px solid var(--control);
    border-radius: var(--radius);
    cursor: pointer;
  }

  button:disabled {
    cursor: progress;
  }

  button.primary {
    width: 100%;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }

  .icon {
    flex: none;
    width: 1.25em;
    height: 1.25em;
  }

  .brand {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.75rem;
    margin: 0.5rem 0;
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  footer {
    margin-top: 3rem;
    padding: 0.5rem 0 1rem;
    font-size: 0.875rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }
</style>
