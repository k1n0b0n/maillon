---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Comparer marche, vélo, transports en commun et vélo embarqué à Bordeaux." />
    <title>{title} – maillon</title>
  </head>
  <body>
    <header>
      <a href="/" class="brand">maillon</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Données : TBM (Licence Ouverte), SNCF (ODbL), ©&nbsp;<a href="https://www.openstreetmap.org/copyright"
          >contributeurs OpenStreetMap</a
        > (ODbL). <a href="https://github.com/k1n0b0n/maillon">Code source</a> sous licence MIT.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --text: #1b1b1b;
    --muted: #555;
    --background: #fff;
    --accent: #005f87;
    --error: #b00020;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --text: #ececec;
      --muted: #b5b5b5;
      --background: #151515;
      --accent: #7cc8ef;
      --error: #ff8a8a;
    }
  }

  body {
    margin: 0 auto;
    max-width: 40rem;
    padding: 0 1rem;
    color: var(--text);
    background: var(--background);
  }

  a {
    color: var(--accent);
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .brand {
    display: inline-block;
    padding: 1rem 0;
    font-weight: 700;
    text-decoration: none;
  }

  footer {
    margin-top: 3rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
